# Required for live LinkedIn search through Tavily.
TAVILY_API_KEY=

# Required for CopilotKit chat and AI-based CV extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_JOB_ANALYSIS_MODEL=gpt-5-nano
OPENAI_INPUT_COST_PER_MILLION=0.40
OPENAI_OUTPUT_COST_PER_MILLION=1.60
USD_TO_PLN=4.0
CREDIT_COST_MULTIPLIER=10
CURRENCY_RATE_URL=https://api.frankfurter.dev/v2/rate/EUR/USD
CURRENCY_RATE_CACHE_MINUTES=60

# Application and authentication.
RECRBRO_DATABASE_PATH=data/recrbro.db
# Comma-separated; legacy deployments may keep using FRONTEND_ORIGIN.
# The first origin is used for OAuth and payment redirects.
FRONTEND_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://127.0.0.1:8000
APP_ENV=development
APP_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=168
SEED_DEMO_USERS=true

# Google OAuth. The redirect URI must also be registered in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Free-plan email delivery through the Mailgun Messages API.
# Sandbox domains can send only to recipients authorized in Mailgun.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=sandbox.example.mailgun.org
MAILGUN_REGION=US
MAILGUN_FROM=RecrBro <postmaster@sandbox.example.mailgun.org>

# Przelewy24 Premium checkout. Keep sandbox enabled until certification passes.
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC=
P24_SANDBOX=true

# LangSmith tracing is enabled by the standard LangChain variables.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=recrbro-production

COPILOTKIT_TELEMETRY_DISABLED=true
