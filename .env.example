# Enables broad web job discovery and per-offer detail crawling through Tavily.
TAVILY_API_KEY=

# Public Remote MCP source for Polish IT job offers.
CZYJESTELDORADO_MCP_URL=https://czyjesteldorado.pl/_mcp
CZYJESTELDORADO_MCP_TIMEOUT_SECONDS=30

# Required for CopilotKit chat and AI-based CV extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_JOB_ANALYSIS_MODEL=gpt-5-nano
OPENAI_INPUT_COST_PER_MILLION=0.40
OPENAI_OUTPUT_COST_PER_MILLION=1.60
USD_TO_PLN=4.0
CREDIT_COST_MULTIPLIER=10
FREE_STARTING_CREDITS=0.1
CURRENCY_RATE_URL=https://api.frankfurter.dev/v2/rate/EUR/USD
CURRENCY_RATE_CACHE_MINUTES=60

# Application and authentication.
RECRBRO_DATABASE_PATH=data/recrbro.db
# Comma-separated; legacy deployments may keep using FRONTEND_ORIGIN.
FRONTEND_ORIGINS=http://localhost:3000
APP_ENV=development
APP_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=168
SEED_DEMO_USERS=true

# Cloudflare Turnstile. This always-pass test key is for local development only.
# Keep the real production secret key only on the API service.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# LangSmith tracing is enabled by the standard LangChain variables.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=recrbro-production

COPILOTKIT_TELEMETRY_DISABLED=true
